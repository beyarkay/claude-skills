#!/usr/bin/env bash
# drop-user-in-file — pause Claude Code, float an interactive nvim popup over the
# user's tmux pane at PATH:LINE, block until they :q, then print the before/after diff.
#
# Usage: drop-user-in-file PATH [LINE]
#
# How it works: this runs from Claude's non-interactive Bash subshell (no TTY),
# but `tmux display-popup` talks to the tmux *server*, which paints an interactive
# popup onto the user's attached client. `display-popup -E` blocks the invoking
# shell until the popup command exits, so Claude's tool call naturally waits for
# the edit session to finish. We diff a backup against the saved file afterwards.

set -euo pipefail

path="${1:?usage: drop-user-in-file PATH [LINE]}"
line="${2:-1}"

if [ -z "${TMUX:-}" ]; then
  echo "ERROR: not inside tmux — cannot open an interactive popup." >&2
  echo "Claude's Bash subshell has no TTY; tmux is what lets nvim render on your screen." >&2
  exit 3
fi

if ! command -v nvim >/dev/null 2>&1; then
  echo "ERROR: nvim not found on PATH." >&2
  exit 4
fi

# Absolute path so the popup (different cwd) opens the right file.
case "$path" in
  /*) abs="$path" ;;
  *)  abs="$PWD/$path" ;;
esac

mkdir -p "$(dirname -- "$abs")"

# Snapshot the before-state (empty if the file doesn't exist yet).
backup="$(mktemp)"
trap 'rm -f "$backup"' EXIT
if [ -e "$abs" ]; then
  cp -- "$abs" "$backup"
fi

# Build the in-popup command with safe quoting (path may contain spaces).
q_abs=$(printf '%q' "$abs")
q_line=$(printf '%q' "$line")

# --- Window gate ---------------------------------------------------------
# A tmux popup floats over whatever window the client is *currently* viewing.
# When running several Claudes side by side that's an ambush. So if this
# Claude's window isn't the active one, don't pop yet: flag the window name
# so the user can spot which Claude wants attention, and wait until they
# switch back to it. The popup then appears on the right window only.
claude_pane="${TMUX_PANE:?TMUX_PANE unset}"
if [ "$(tmux display-message -p -t "$claude_pane" '#{window_active}')" != "1" ]; then
  orig_name="$(tmux display-message -p -t "$claude_pane" '#{window_name}')"
  auto_rename="$(tmux show-options -wqv -t "$claude_pane" automatic-rename || true)"
  tmux rename-window -t "$claude_pane" "✎ EDIT WAITING — $orig_name" 2>/dev/null || true
  # Restore the name no matter how we exit the wait.
  restore_name() {
    tmux rename-window -t "$claude_pane" "$orig_name" 2>/dev/null || true
    [ "$auto_rename" = "on" ] && tmux set-option -w -t "$claude_pane" automatic-rename on 2>/dev/null || true
  }
  trap 'rm -f "$backup"; restore_name' EXIT
  while [ "$(tmux display-message -p -t "$claude_pane" '#{window_active}')" != "1" ]; do
    sleep 0.3
  done
  restore_name
  trap 'rm -f "$backup"' EXIT
fi
# -------------------------------------------------------------------------

# Anchored at the top, ~1 column margin each side, leaving the bottom BOTTOM_FREE
# rows uncovered so the user can still read Claude's latest response. Falls back
# to a top-anchored 80%-tall popup if client dimensions can't be read.
BOTTOM_FREE=20
cw="$(tmux display-message -p -t "$claude_pane" '#{client_width}' 2>/dev/null || true)"
ch="$(tmux display-message -p -t "$claude_pane" '#{client_height}' 2>/dev/null || true)"
ypos=1   # top of popup, 1 row down (absolute, works even without dims)
if [ -n "$cw" ] && [ -n "$ch" ] && [ "$cw" -gt 4 ] && [ "$ch" -gt $((BOTTOM_FREE + 6)) ]; then
  pw=$((cw - 2)); ph=$((ch - BOTTOM_FREE - ypos))
else
  pw="90%"; ph="80%"
fi

# Titled with the file. nvim opens at +LINE. `-E` closes the popup and unblocks
# us the moment nvim exits. `-t` anchors it to this Claude's pane/client; `-y`
# pins it to the top.
tmux display-popup -E -t "$claude_pane" -y "$ypos" -w "$pw" -h "$ph" \
  -T " editing $(basename -- "$abs") :$line — :wq to return to Claude " \
  "nvim +${q_line} -- ${q_abs}"

# Report the diff (never truncated — per project convention).
echo "=== drop-user-in-file: $abs (opened at line $line) ==="
if [ ! -e "$abs" ]; then
  echo "RESULT: file does not exist after edit (you did not save / created nothing)."
  exit 0
fi
if cmp -s "$backup" "$abs"; then
  echo "RESULT: no changes ($(wc -l < "$abs" | tr -d ' ') lines)."
else
  echo "RESULT: file changed. Unified diff (before -> after):"
  echo "---"
  diff -u --label "before" --label "after" "$backup" "$abs" || true
  echo "---"
fi
